# =============================================================
# MediQueue — Environment Variables Example
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env with real secrets.
# =============================================================

# ----- NEXT.JS FRONTEND -----

# Backend API URL (Spring Boot). Change for production deployment.
NEXT_PUBLIC_API_URL=http://localhost:8080

# LAN IP for QR code generation (mobile patient scanning)
# Set this to your Wi-Fi IP so QR codes work on the local network.
NEXT_PUBLIC_LAN_IP=10.20.4.229

# App base URL (used for QR code links in production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_PAYMENT=true   # Shows "Demo Payment — No Real Money Charged"


# ----- SPRING BOOT BACKEND -----
# These go in backend/src/main/resources/application-prod.yml
# or as environment variables in your deployment platform.

# Database (MySQL for production; H2 is used by default for demo)
MYSQL_URL=jdbc:mysql://localhost:3306/mediqueue_db?useSSL=false&serverTimezone=Asia/Kolkata
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# JWT Secret (minimum 256 bits)
JWT_SECRET=REPLACE_WITH_A_STRONG_256BIT_SECRET_KEY_DO_NOT_COMMIT
JWT_EXPIRY_HOURS=24

# Hospital configuration
HOSPITAL_NAME=Diksha Hospital
HOSPITAL_TIMEZONE=Asia/Kolkata

# ----- PAYMENT GATEWAY (Demo mode: not required) -----
# For real payment integration, replace with actual credentials.
RAZORPAY_KEY_ID=DEMO_KEY_PLACEHOLDER
RAZORPAY_KEY_SECRET=DEMO_SECRET_PLACEHOLDER

# ----- SMS / NOTIFICATIONS (Demo mode: not required) -----
# Twilio or MSG91 for real SMS delivery
SMS_PROVIDER=DEMO
TWILIO_ACCOUNT_SID=DEMO_SID_PLACEHOLDER
TWILIO_AUTH_TOKEN=DEMO_TOKEN_PLACEHOLDER
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
